# ==============================================================================
# NetPulse v4.5.0 — Production Environment Configuration
# Copy to .env or export in your systemd / Docker environment
# ==============================================================================

# Server Bind Address & Port
NETPULSE_HOST=0.0.0.0
NETPULSE_PORT=8765

# Cryptographic HMAC-SHA256 Signing Secret for NP1-* License Keys
# (Auto-generated and persisted in SQLite if not set)
NETPULSE_LICENSE_SECRET=

# Sovereign Admin Master Token (Protects /api/subscription/admin/* & /stripe-config)
# (Auto-generated and saved to ~/.config/netpulse/admin.token with 0600 permissions if not set)
NETPULSE_ADMIN_TOKEN=

# Stripe Live / Test Billing Credentials
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
